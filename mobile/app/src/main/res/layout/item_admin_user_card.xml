<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/home_card_shell"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvAdminUserName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ug_maroon_dark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAdminUserEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/ug_text_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvAdminUserRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/status_available_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:textColor="@color/status_available_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAdminUserCreated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/ug_text_muted"
        android:textSize="13sp" />
</LinearLayout>
