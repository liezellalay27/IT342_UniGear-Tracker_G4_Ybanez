<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/splash_card_bg"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reset your password"
        android:textColor="@color/ug_maroon_dark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvForgotMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp"
        android:text="We’ll send a reset link to your inbox using the same backend and SMTP setup as the web app."
        android:textColor="@color/ug_text_muted"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etForgotEmail"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Enter your email"
        android:inputType="textEmailAddress"
        android:background="@drawable/auth_input_bg"
        android:paddingHorizontal="12dp"
        android:textColor="@color/ug_near_black"
        android:textColorHint="@color/ug_text_muted" />

</LinearLayout>
