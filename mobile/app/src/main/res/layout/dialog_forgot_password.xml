<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@color/ug_off_white">

    <TextView
        android:id="@+id/tvForgotMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="We will send a password reset email using the same backend and SMTP setup as the web app."
        android:textColor="#333333"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etForgotEmail"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Enter your email"
        android:inputType="textEmailAddress"
        android:background="@drawable/auth_input_bg"
        android:paddingHorizontal="12dp"
        android:textColor="#222222" />

</LinearLayout>
