<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mobile_app">

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@drawable/splash_card_bg"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/btnAdminEquipmentBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Back"
                android:src="@android:drawable/ic_media_previous"
                app:tint="@color/ug_near_black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Back"
                android:textColor="@color/ug_near_black"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnAdminEquipmentRefresh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Refresh"
                android:src="@android:drawable/ic_popup_sync"
                app:tint="@color/ug_maroon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Refresh"
                android:textColor="@color/ug_maroon"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Equipment Admin"
                android:textColor="@color/ug_maroon_dark"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Add, search, and manage inventory in one place"
                android:textColor="@color/ug_maroon"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvEquipmentAdminError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/auth_error_bg"
                android:padding="10dp"
                android:textColor="#B00020"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvEquipmentAdminLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/ug_maroon"
                android:textSize="13sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etAdminEquipmentSearch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/auth_input_bg"
                android:hint="Search equipment by name or category"
                android:paddingHorizontal="12dp"
                android:textColor="@color/ug_near_black"
                android:textColorHint="@color/ug_text_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="@drawable/home_card_shell"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add Equipment"
                    android:textColor="@color/ug_maroon_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etAdminEquipmentName"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/auth_input_bg"
                    android:hint="Name"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/ug_near_black"
                    android:textColorHint="@color/ug_text_muted" />

                <EditText
                    android:id="@+id/etAdminEquipmentCategory"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/auth_input_bg"
                    android:hint="Category"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/ug_near_black"
                    android:textColorHint="@color/ug_text_muted" />

                <EditText
                    android:id="@+id/etAdminEquipmentLocation"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/auth_input_bg"
                    android:hint="Location"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/ug_near_black"
                    android:textColorHint="@color/ug_text_muted" />

                <EditText
                    android:id="@+id/etAdminEquipmentDescription"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/auth_input_bg"
                    android:gravity="top"
                    android:hint="Description"
                    android:inputType="textMultiLine"
                    android:padding="12dp"
                    android:textColor="@color/ug_near_black"
                    android:textColorHint="@color/ug_text_muted" />

                <EditText
                    android:id="@+id/etAdminEquipmentSpecifications"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/auth_input_bg"
                    android:gravity="top"
                    android:hint="Specifications, one per line or comma-separated"
                    android:inputType="textMultiLine"
                    android:padding="12dp"
                    android:textColor="@color/ug_near_black"
                    android:textColorHint="@color/ug_text_muted" />

                <EditText
                    android:id="@+id/etAdminEquipmentTotalQty"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/auth_input_bg"
                    android:hint="Total quantity"
                    android:inputType="number"
                    android:paddingHorizontal="12dp"
                    android:textColor="#222222" />

                <EditText
                    android:id="@+id/etAdminEquipmentAvailableQty"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/auth_input_bg"
                    android:hint="Available quantity"
                    android:inputType="number"
                    android:paddingHorizontal="12dp"
                    android:textColor="#222222" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnAdminEquipmentCreate"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/auth_primary_button"
                        android:backgroundTint="@null"
                        android:text="Create"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnAdminEquipmentCancel"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/button_background"
                        android:backgroundTint="@null"
                        android:text="Cancel"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:visibility="gone"
                        android:textStyle="bold" />

                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Existing Equipment"
                android:textColor="@color/ug_maroon_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/llEquipmentAdminList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
